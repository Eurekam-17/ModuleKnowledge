<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Id de l'article racine partagé avec le portail. Valeur par défaut = prod (19).
        À vérifier / ajuster par base dans Paramètres → Technique → Paramètres système.
        noupdate : une mise à jour du module n'écrase pas la valeur réglée par un admin.
    -->
    <record id="kb_root_param" model="ir.config_parameter">
        <field name="key">eurekam_knowledge_portal.root_article_id</field>
        <field name="value">19</field>
    </record>

    <!--
        Rubriques par langue, sous la racine : « en:463, de:520, it:530 ».
        - compte en français : base partagée SANS ces rubriques ;
        - compte dans une langue listée : UNIQUEMENT sa rubrique ;
        - autre langue : la rubrique anglaise (langue de repli).
        Vide : pas de tri par langue, tout le monde voit toute la base.
    -->
    <record id="kb_lang_roots_param" model="ir.config_parameter">
        <field name="key">eurekam_knowledge_portal.lang_root_articles</field>
        <field name="value">en:463</field>
    </record>
</odoo>
